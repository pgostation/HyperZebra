msgctxt "script"
msgid "{0} — {1}: {2}"
msgstr "{0} — {1}行: {2}"

#: ScriptEditor.java
msgid "Warning: {0}"
msgstr "警告: {0}"

#: ScriptEditor.java
msgid "Error: {0}"
msgstr "エラー: {0}"

#: ScriptEditor.java
msgid "Click to toggle checkpoint"
msgstr "クリックしてチェックポイントを切り替え"

#: ScriptEditor.java
msgid "Closing parenthesis has no matching opening parenthesis."
msgstr "対応する開き括弧がありません。"

#: ScriptEditor.java
msgid "String literal is not closed."
msgstr "文字列を閉じる引用符がありません。"

#: ScriptEditor.java
msgid "Opening parenthesis is not closed."
msgstr "開き括弧が閉じられていません。"

#: ScriptEditor.java
msgid "Handler name is missing."
msgstr "ハンドラ名がありません。"

#: ScriptEditor.java
msgid "Handler \"{0}\" is not closed with end {0}."
msgstr "ハンドラ「{0}」を閉じる end {0} がありません。"

#: ScriptEditor.java
msgid "repeat {0} requires a condition."
msgstr "repeat {0} の条件がありません。"

#: ScriptEditor.java
msgid "repeat with requires 'variable = start to end'."
msgstr "repeat with には「変数 = 開始値 to 終了値」が必要です。"

#: ScriptEditor.java
msgid "end repeat has no matching repeat."
msgstr "対応する repeat がありません。"

#: ScriptEditor.java
msgid "{0} repeat is outside a repeat block."
msgstr "{0} repeat が repeat ブロックの外にあります。"

#: ScriptEditor.java
msgid "end has no matching handler."
msgstr "対応するハンドラ開始行がありません。"

#: ScriptEditor.java
msgid "Expected end {0}."
msgstr "end {0} が必要です。"

#: ScriptEditor.java
msgid "if statement requires a condition."
msgstr "if 文の条件がありません。"

#: ScriptEditor.java
msgid "if statement requires then."
msgstr "if文にはthenが必要です"

#: ScriptEditor.java
msgid "Multi-line if statement is not closed with end if."
msgstr "end ifが見つかりません"

#: ScriptEditor.java
msgid "Invalid if structure."
msgstr "if 文の構造が正しくありません。"

#: ScriptEditor.java
msgid "else has no matching if."
msgstr "対応する if の無い else です。"

#: ScriptEditor.java
msgid "then has no matching if."
msgstr "対応する if の無い then です。"

#: ScriptEditor.java
msgid "end if has no matching if."
msgstr "対応する if の無い end if です。"

#: ScriptEditor.java
msgid "Continuation marker has no following line."
msgstr "継続記号の次の行がありません。"

#: ScriptEditor.java
msgid "repeat is not closed with end repeat."
msgstr "repeat を閉じる end repeat がありません。"

#: ScriptLint.java
msgid "Handler \"{0}\" is already defined on line {1}; this one is never called."
msgstr "ハンドラ「{0}」は{1}行目にもあります。こちらは呼ばれません。"

#: ScriptLint.java
msgid "repeat with has no end value after to."
msgstr "repeat with の to の後に終了値がありません。"

#: ScriptLint.java
msgid "repeat needs a count."
msgstr "repeat の回数がありません。"

#: ScriptLint.java
msgid "A statement must start with a command; this line is only a value."
msgstr "文はコマンドで始めてください(この行は値だけです)。"

#: ScriptLint.java
msgid "{0} needs more words."
msgstr "{0} の後に続きがありません。"

#: ScriptLint.java
msgid "repeat must start its own line."
msgstr "repeat は行の先頭に書いてください。"

#: ScriptLint.java
msgid "exit must be followed by repeat, {0} or to HyperCard."
msgstr "exit の後には repeat、{0}、to HyperCard のどれかが必要です。"

#: ScriptLint.java
msgid "pass must name this handler: pass {0}."
msgstr "pass にはこのハンドラの名前が必要です(pass {0})。"

#: ScriptLint.java
msgid "next must be next repeat."
msgstr "next は next repeat と書いてください。"

#: ScriptLint.java
msgid "global expects variable names separated by commas."
msgstr "global には変数名をカンマで区切って書いてください。"

#: ScriptLint.java
msgid "No handler, XCMD or built-in command named \"{0}\" was found (typo?)."
msgstr "「{0}」というハンドラ・XCMD・組み込みコマンドが見つかりません(打ち間違い?)。"

#: ScriptLint.java
msgid "put needs a value before into."
msgstr "put の後に入れる値がありません。"

#: ScriptLint.java
msgid "put needs a value before after."
msgstr "put の後に入れる値がありません。"

#: ScriptLint.java
msgid "put needs a value before before."
msgstr "put の後に入れる値がありません。"

#: ScriptLint.java
msgid "put … {0} needs a container."
msgstr "put … {0} の後に入れ物がありません。"

#: ScriptLint.java
msgid "set needs to: set [the] property [of object] to value."
msgstr "set には to が必要です(set [the] プロパティ [of オブジェクト] to 値)。"

#: ScriptLint.java
msgid "set needs a property name."
msgstr "set のプロパティ名がありません。"

#: ScriptLint.java
msgid "set … to needs a value."
msgstr "set … to の後に値がありません。"

#: ScriptLint.java
msgid "add needs the form: add value to container."
msgstr "add は「add 値 to 入れ物」の形で書いてください。"

#: ScriptLint.java
msgid "subtract needs the form: subtract value from container."
msgstr "subtract は「subtract 値 from 入れ物」の形で書いてください。"

#: ScriptLint.java
msgid "multiply needs the form: multiply container by value."
msgstr "multiply は「multiply 入れ物 by 値」の形で書いてください。"

#: ScriptLint.java
msgid "divide needs the form: divide container by value."
msgstr "divide は「divide 入れ物 by 値」の形で書いてください。"

#: ScriptLint.java
msgid "wait {0} needs a condition."
msgstr "wait {0} の条件がありません。"

#: ScriptLint.java
msgid "send needs a message."
msgstr "send するメッセージがありません。"

#: ScriptLint.java
msgid "send … to needs an object."
msgstr "send … to の後に送り先がありません。"

#: ScriptLint.java
msgid "Empty parentheses."
msgstr "括弧の中に式がありません。"

#: ScriptLint.java
msgid "No function handler, XFCN or built-in function named \"{0}\" was found (typo?)."
msgstr "「{0}」という関数ハンドラ・XFCN・組み込み関数が見つかりません(打ち間違い?)。"

#: ScriptLint.java
msgid "Operator {0} has no value before it."
msgstr "演算子 {0} の前に値がありません。"

#: ScriptLint.java
msgid "Operator {0} has no value after it."
msgstr "演算子 {0} の後に値がありません。"

msgid ""
"-- This object's script is compiled {0} (OSA '{1}', {2} bytes).\n"
"-- HyperZebra does not run {0} object scripts: the object is treated as having\n"
"-- no handlers and messages pass on through it (as in HyperCard without AppleScript).\n"
"-- The compiled data is kept unchanged and is written back when the stack is exported to HyperCard.\n"
"-- To rewrite it in HyperTalk, run this in the message box, then edit the script:\n"
"--   set the scriptingLanguage of {3} to \"HyperTalk\""
msgstr ""
"-- このオブジェクトのスクリプトは、コンパイル済みの {0} (OSA '{1}'、{2} バイト) です。\n"
"-- HyperZebra は {0} のオブジェクトスクリプトを実行しません。このオブジェクトは\n"
"-- ハンドラを持たないものとして扱われ、メッセージはそのまま次のオブジェクトへ渡ります\n"
"-- (AppleScript の無い HyperCard と同じ動作です)。\n"
"-- スクリプトのデータはそのまま保存され、HyperCard 形式に書き出すと元に戻ります。\n"
"-- HyperTalk で書き直すには、メッセージボックスで次を実行してからスクリプトを編集します:\n"
"--   set the scriptingLanguage of {3} to \"HyperTalk\""

