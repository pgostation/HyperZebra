msgstr "put richiede un valore prima di after."

#: ScriptLint.java
msgid "put needs a value before before."
msgstr "put richiede un valore prima di before."

#: ScriptLint.java
msgid "put … {0} needs a container."
msgstr "put … {0} richiede un contenitore."

#: ScriptLint.java
msgid "set needs to: set [the] property [of object] to value."
msgstr "Set deve: impostare [la] proprietà [dell'oggetto] al valore."

#: ScriptLint.java
msgid "set needs a property name."
msgstr "set richiede un nome di proprietà."

#: ScriptLint.java
msgid "set … to needs a value."
msgstr "set … to richiede un valore."

#: ScriptLint.java
msgid "add needs the form: add value to container."
msgstr "Aggiungi ha bisogno del modulo: aggiungi valore al contenitore."

#: ScriptLint.java
msgid "subtract needs the form: subtract value from container."
msgstr "Sottrarre ha bisogno del modulo: sottrarre valore dal contenitore."

#: ScriptLint.java
msgid "multiply needs the form: multiply container by value."
msgstr "Moltiplicare ha bisogno della forma: moltiplicare il contenitore per valore."

#: ScriptLint.java
msgid "divide needs the form: divide container by value."
msgstr "Dividere ha bisogno della forma: dividere il contenitore per valore."

#: ScriptLint.java
msgid "wait {0} needs a condition."
msgstr "wait {0} richiede una condizione."

#: ScriptLint.java
msgid "send needs a message."
msgstr "send richiede un messaggio."

#: ScriptLint.java
msgid "send … to needs an object."
msgstr "send … to richiede un oggetto."

#: ScriptLint.java
msgid "Empty parentheses."
msgstr "Parentesi vuote."

#: ScriptLint.java
msgid "No function handler, XFCN or built-in function named \"{0}\" was found (typo?)."
msgstr "Non è stato trovato nessun gestore di funzioni, XFCN o funzione integrata denominata \"{0}\" (errore di battitura?)."

#: ScriptLint.java
msgid "Operator {0} has no value before it."
msgstr "L'operatore {0} non ha valore prima di esso."

#: ScriptLint.java
msgid "Operator {0} has no value after it."
msgstr "L'operatore {0} non ha valore dopo di esso."

msgid ""
"-- This object's script is compiled {0} (OSA '{1}', {2} bytes).\n"
"-- HyperZebra does not run {0} object scripts: the object is treated as having\n"
"-- no handlers and messages pass on through it (as in HyperCard without AppleScript).\n"
"-- The compiled data is kept unchanged and is written back when the stack is exported to HyperCard.\n"
"-- To rewrite it in HyperTalk, run this in the message box, then edit the script:\n"
"--   set the scriptingLanguage of {3} to \"HyperTalk\""
msgstr ""
"-- Lo script di questo oggetto è compilato {0} (OSA '{1}', {2} byte).\n"
"\n"
"-- HyperZebra non esegue {0} script di oggetti: l'oggetto viene trattato come avente\n"
"\n"
"-- nessun gestore e messaggio passa attraverso di esso (come in HyperCard senza AppleScript).\n"
"\n"
"-- I dati compilati vengono mantenuti invariati e vengono riscritti quando lo stack viene esportato in HyperCard.\n"
"\n"
"-- Per riscriverlo in HyperTalk, eseguilo nella casella dei messaggi, quindi modifica lo script:\n"
"\n"
"-- impostare il scriptingLanguage di {3} su \"HyperTalk\""

