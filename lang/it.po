msgstr "next deve essere next repeat."

#: ScriptLint.java
msgid "global expects variable names separated by commas."
msgstr "Globale si aspetta nomi di variabili separati da virgole."

#: ScriptLint.java
msgid "No handler, XCMD or built-in command named \"{0}\" was found (typo?)."
msgstr "Non è stato trovato nessun gestore, XCMD o comando integrato denominato \"{0}\" (errore di battitura?)."

#: ScriptLint.java
msgid "put needs a value before into."
msgstr "put richiede un valore prima di into."

