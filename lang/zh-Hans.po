msgstr "then 没有对应的 if。"

#: ScriptEditor.java
msgid "end if has no matching if."
msgstr "end if 没有对应的 if。"

#: ScriptEditor.java
msgid "Continuation marker has no following line."
msgstr "续行标记后面没有下一行。"

#: ScriptEditor.java
msgid "repeat is not closed with end repeat."
msgstr "repeat 没有用 end repeat 结束。"

#: ScriptLint.java
msgid "Handler \"{0}\" is already defined on line {1}; this one is never called."
msgstr "处理程序“{0}”已在第 {1} 行定义；此处的处理程序永远不会被调用。"

#: ScriptLint.java
msgid "repeat with has no end value after to."
msgstr "repeat with 的 to 后面没有结束值。"

#: ScriptLint.java
msgid "repeat needs a count."
msgstr "repeat 需要次数。"

