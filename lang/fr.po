msgid "Bézier curve"
msgstr "Courbe de Bézier"

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Card"
msgstr "Carte"

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Background"
msgstr "Arrière-plan"

#: ShapeInfoPanel.java
