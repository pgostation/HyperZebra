#: ScriptEditor.java
msgid "end if has no matching if."
msgstr "end if n’a pas de if correspondant."

#: ScriptEditor.java
msgid "Continuation marker has no following line."
msgstr "Le marqueur de continuation n'est suivi d'aucune ligne."

#: ScriptEditor.java
msgid "repeat is not closed with end repeat."
msgstr "repeat n’est pas fermé par end repeat."

#: ScriptLint.java
msgid "Handler \"{0}\" is already defined on line {1}; this one is never called."
msgstr "Le gestionnaire \"{0}\" est déjà défini en ligne {1} ; celui-ci n'est jamais appelé."

#: ScriptLint.java
msgid "repeat with has no end value after to."
msgstr "repeat with n’a pas de valeur finale après to."

#: ScriptLint.java
msgid "repeat needs a count."
msgstr "repeat a besoin d’un nombre."

#: ScriptLint.java
msgid "A statement must start with a command; this line is only a value."
msgstr "Une instruction doit commencer par une commande ; cette ligne n'est qu'une valeur."

#: ScriptLint.java
msgid "{0} needs more words."
msgstr "{0} a besoin de plus de mots."

#: ScriptLint.java
msgid "repeat must start its own line."
msgstr "repeat doit commencer sa propre ligne."

#: ScriptLint.java
msgid "exit must be followed by repeat, {0} or to HyperCard."
msgstr "exit doit être suivi de repeat, {0} ou to HyperCard."

#: ScriptLint.java
msgid "pass must name this handler: pass {0}."
msgstr "pass doit nommer ce gestionnaire : pass {0}."

#: ScriptLint.java
msgid "next must be next repeat."
msgstr "next doit être next repeat."

#: ScriptLint.java
msgid "global expects variable names separated by commas."
msgstr "global attend des noms de variables séparés par des virgules."

#: ScriptLint.java
msgid "No handler, XCMD or built-in command named \"{0}\" was found (typo?)."
msgstr "Aucun gestionnaire, XCMD ou commande intégrée nommée \"{0}\" n'a été trouvé (faute de frappe ?)."

#: ScriptLint.java
msgid "put needs a value before into."
msgstr "put a besoin d’une valeur avant into."

#: ScriptLint.java
msgid "put needs a value before after."
msgstr "put a besoin d’une valeur avant after."

#: ScriptLint.java
msgid "put needs a value before before."
msgstr "put a besoin d’une valeur avant before."

#: ScriptLint.java
msgid "put … {0} needs a container."
msgstr "put … {0} a besoin d’un conteneur."

#: ScriptLint.java
msgid "set needs to: set [the] property [of object] to value."
msgstr "set a besoin de to : set [the] propriété [of objet] to valeur."

#: ScriptLint.java
msgid "set needs a property name."
msgstr "set a besoin d’un nom de propriété."

#: ScriptLint.java
msgid "set … to needs a value."
msgstr "set … to a besoin d’une valeur."

#: ScriptLint.java
msgid "add needs the form: add value to container."
msgstr "add nécessite la forme : add valeur to conteneur."

#: ScriptLint.java
msgid "subtract needs the form: subtract value from container."
msgstr "subtract nécessite la forme : subtract valeur from conteneur."

#: ScriptLint.java
msgid "multiply needs the form: multiply container by value."
msgstr "multiply nécessite la forme : multiply conteneur by valeur."

#: ScriptLint.java
msgid "divide needs the form: divide container by value."
msgstr "divide nécessite la forme : divide conteneur by valeur."

#: ScriptLint.java
msgid "wait {0} needs a condition."
msgstr "wait {0} a besoin d’une condition."

#: ScriptLint.java
msgid "send needs a message."
msgstr "send a besoin d’un message."

#: ScriptLint.java
msgid "send … to needs an object."
msgstr "send … to a besoin d’un objet."

#: ScriptLint.java
msgid "Empty parentheses."
msgstr "Parenthèses vides."

#: ScriptLint.java
msgid "No function handler, XFCN or built-in function named \"{0}\" was found (typo?)."
msgstr "Aucun gestionnaire de fonction, XFCN ou fonction intégrée nommé \"{0}\" n'a été trouvé (faute de frappe ?)."

#: ScriptLint.java
msgid "Operator {0} has no value before it."
msgstr "L'opérateur {0} n'a aucune valeur avant lui."

#: ScriptLint.java
msgid "Operator {0} has no value after it."
msgstr "L'opérateur {0} n'a aucune valeur après."

msgid ""
"-- This object's script is compiled {0} (OSA '{1}', {2} bytes).\n"
"-- HyperZebra does not run {0} object scripts: the object is treated as having\n"
"-- no handlers and messages pass on through it (as in HyperCard without AppleScript).\n"
"-- The compiled data is kept unchanged and is written back when the stack is exported to HyperCard.\n"
"-- To rewrite it in HyperTalk, run this in the message box, then edit the script:\n"
"--   set the scriptingLanguage of {3} to \"HyperTalk\""
msgstr ""
"-- Le script de cet objet est compilé {0} (OSA '{1}', {2} octets).\n"
"\n"
"-- HyperZebra n'exécute pas {0} scripts d'objet : l'objet est traité comme ayant\n"
"\n"
"-- Aucun gestionnaire et message ne le transmet (comme dans HyperCard sans AppleScript).\n"
"\n"
"-- Les données compilées sont maintenues inchangées et sont réécrites lorsque la pile est exportée vers HyperCard.\n"
"\n"
"-- Pour le réécrire dans HyperTalk, exécutez-le dans la zone de message, puis modifiez le script :\n"
"\n"
"-- Régler le scriptingLanguage de {3} sur \"HyperTalk\""

