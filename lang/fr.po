msgid "Shape number"
msgstr "Numéro de forme"

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Shape ID"
msgstr "ID de forme"

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "The number follows shape order within its owner. The ID stays the same."
msgstr "Le numéro suit l'ordre des formes au sein de leur propriétaire. L'ID reste le même."

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Close Shape Info and edit the shape's script (mouseUp and other messages)."
msgstr "Ferme les informations sur la forme et modifie son script (mouseUp et autres messages)."

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Show shape"
msgstr "Afficher la forme"

#: ShapeInfoPanel.java
msgctxt "shape"
msgid "Also drag the round handle above the selected shape with the Shape tool."
