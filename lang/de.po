msgid "set needs to: set [the] property [of object] to value."
msgstr "set braucht to: set [the] Eigenschaft [of Objekt] to Wert."

#: ScriptLint.java
msgid "set needs a property name."
msgstr "set braucht einen Eigenschaftsnamen."

#: ScriptLint.java
msgid "set … to needs a value."
msgstr "set … to braucht einen Wert."

#: ScriptLint.java
msgid "add needs the form: add value to container."
msgstr "add braucht die Form: add Wert to Container."

#: ScriptLint.java
msgid "subtract needs the form: subtract value from container."
msgstr "subtract braucht die Form: subtract Wert from Container."

