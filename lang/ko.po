msgstr "전체 경로를 창 제목으로"

msgctxt "reference"
msgid "The channel play uses"
msgstr "play가 사용하는 채널"

msgctxt "reference"
msgid "Print margins and text"
msgstr "인쇄 여백 및 텍스트"

