msgid "The system's language"
msgstr "시스템의 언어"

msgctxt "reference"
msgid "Creates an array (counts from 1)"
msgstr "배열을 생성합니다 (1부터 셈)"

msgctxt "reference"
msgid "Creates a dictionary"
msgstr "사전을 생성합니다"

msgctxt "reference"
msgid "The nth array element"
msgstr "n번째 배열 요소"

msgctxt "reference"
msgid "A dictionary value"
msgstr "사전 값"

